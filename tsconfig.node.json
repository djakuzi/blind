{
  "include": [
    "vite.config.*",
    "electron.vite.config.*",
    "electron/**/*.ts"
  ],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true
  }
}
