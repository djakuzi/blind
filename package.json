{
  "name": "blind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "app:generate:style-contracts": "node scripts/generators/generateStyleContracts.js",
    "app:generate:docs-versions": "node scripts/generators/generateDocsVersions.js",
    "app:generate:icons-assets": "node scripts/generators/generateIconsProject.js",
    "app:generate:audio-assets": "node scripts/generators/generateAudioProject.js",
    "app:generate:fonts-woff2": "node scripts/generators/generateFontsWoff2.js",
    "dev": "vite --mode debug",
    "dev:debug": "vite --mode debug",
    "dev:prod": "vite --mode prod",
    "build": "vue-tsc -b && vite build --mode prod",
    "build:debug": "vue-tsc -b && vite build --mode debug",
    "build:prod": "vue-tsc -b && vite build --mode prod",
    "desktop:dev": "vite --config electron.vite.config.ts --mode debug",
    "desktop:build": "vue-tsc -b && vite build --config electron.vite.config.ts --mode prod",
    "format": "prettier \"{scripts,src,public}/**/*.{js,ts,vue,css,json,html}\" --write",
    "format:check": "prettier \"{scripts,src,public}/**/*.{js,ts,vue,css,json,html}\" --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "desktop:package": "npm run desktop:build && npx --yes electron-builder@26.15.3 --config electron-builder.yml --publish never",
    "desktop:package:mac": "npm run desktop:build && npx --yes electron-builder@26.15.3 --config electron-builder.yml --mac --publish never",
    "desktop:package:win": "npm run desktop:build && npx --yes electron-builder@26.15.3 --config electron-builder.yml --win --publish never",
    "desktop:package:linux": "npm run desktop:build && npx --yes electron-builder@26.15.3 --config electron-builder.yml --linux --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@capacitor/text-zoom": "^8.0.1",
    "@capawesome/capacitor-keep-awake": "^0.1.2",
    "@capgo/capacitor-native-audio": "^8.4.30",
    "pinia": "^4.0.3",
    "vue": "^3.5.39",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.1.1",
    "vue-tsc": "^3.3.5",
    "wawoff2": "^2.0.1",
    "electron": "^44.5.1",
    "vite-plugin-electron": "^1.1.2"
  },
  "main": "dist-electron/main.js",
  "description": "Cross-platform 2D PvP arcade game.",
  "author": {
    "name": "djakuzi",
    "email": "145272981+djakuzi@users.noreply.github.com"
  },
  "desktopName": "com.djakuzi.blind"
}
